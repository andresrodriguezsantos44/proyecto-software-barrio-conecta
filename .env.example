# ============================================================================
# BarrioConecta — variables de entorno (ejemplo)
# Copiar a `.env` y completar. `.env` está ignorado por git.
# ============================================================================

# --- API (apps/api) ---------------------------------------------------------
# Puerto del servidor Express (opcional, default 3000).
PORT=3000
# Cadena de conexión a MongoDB (opcional, default mongodb://localhost:27017/barrio-conecta).
MONGODB_URI=mongodb://localhost:27017/barrio-conecta
# Secreto para firmar los JWT (OBLIGATORIO — la API no arranca sin esto).
JWT_SECRET=change-me-in-production
# Vigencia de los JWT (opcional, default 24h).
JWT_EXPIRES_IN=24h

# --- Frontend (apps/web) ----------------------------------------------------
# URL base de la API que usa el SPA. En desarrollo Vite proxea /api, así que
# normalmente no hace falta cambiarla.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Docker Compose (docker-compose.yml) ------------------------------------
# Nombre de la base de datos dentro del contenedor Mongo (opcional).
MONGO_DB=barrio-conecta
# Puerto host expuesto por la API en compose (opcional, default 3000).
API_PORT=3000
# Puerto host expuesto por MongoDB en compose (opcional, default 27017).
MONGO_PORT=27017
# Puerto host expuesto por el frontend en compose (opcional, default 5173).
WEB_PORT=5173

# --- CI/CD (GitHub Actions Secrets — NO van en este archivo) ----------------
# Se configuran como Secrets del repositorio, no en .env. Referencia
# (ver README → "Secrets de CI/CD"):
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID, RENDER_DEPLOY_HOOK
